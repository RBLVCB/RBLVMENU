            bar.BackgroundColor3=Library.CurrentTheme.Accent; bar.BorderSizePixel=0
            bar.AnchorPoint=Vector2.new(0.5,1); bar.Position=UDim2.new(0.5,0,1,0)
            bar.Size=UDim2.new(0.7,0,0,2); bar.BackgroundTransparency=wasActive and 0 or 1
            Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)
        else
