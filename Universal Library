            Knob:SetAttribute("On",Toggled); Knob.AnchorPoint=Vector2.new(0,0.5)
            Knob.Position=Toggled and UDim2.new(1,-21,0.5,0) or UDim2.new(0,3,0.5,0)
            Knob.Size=UDim2.new(0,18,0,18); Knob.BorderSizePixel=0
