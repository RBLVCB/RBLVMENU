            Box.FocusLost:Connect(function(enter)
                Tw(BS,{Transparency=0.72},0.15)
                if enter then pcall(callback,Box.Text) end
            end)

            Library.Elements[text]={Set=function(self,v) Box.Text=v end}
            table.insert(Library.SearchIndex,{Name=text,Tab=name,Instance=Fr})
        end

        function Tab:Keybind(text, default, callback)
            local T=Library.CurrentTheme; local key=default or Enum.KeyCode.Unknown; local binding=false
            Library.Flags[text]=key
            
            local Fr=ElemBase(38); ElemLbl(Fr,text)

            local KB=Instance.new("TextButton",Fr); KB.Name="KeyBtn"
            KB.BackgroundColor3=Color3.fromRGB(255,255,255); KB.BackgroundTransparency=0.88
            KB.AnchorPoint=Vector2.new(1,0.5); KB.Position=UDim2.new(1,-12,0.5,0); KB.Size=UDim2.new(0,74,0,24)
            KB.Font=Enum.Font.GothamMedium; KB.Text=key==Enum.KeyCode.Unknown and "None" or key.Name
            KB.TextColor3=Color3.fromRGB(190,200,215); KB.TextSize=10; KB.AutoButtonColor=false; KB.BorderSizePixel=0
            Instance.new("UICorner",KB).CornerRadius=UDim.new(1,0)

            local kbs=Instance.new("UIStroke",KB); kbs.Color=T.Accent; kbs.Thickness=1; kbs.Transparency=0.72

            KB.MouseButton1Click:Connect(function()
                binding=true; KB.Text="..."; KB.TextColor3=T.Accent; Tw(kbs,{Transparency=0.3},0.12)
            end)

            UserInputService.InputBegan:Connect(function(input,gpe)
                if binding and not gpe and input.UserInputType==Enum.UserInputType.Keyboard then
                    key=input.KeyCode; binding=false; KB.Text=key.Name
                    KB.TextColor3=Color3.fromRGB(190,200,215); Tw(kbs,{Transparency=0.72},0.12)
                    Library.Flags[text]=key
                elseif not binding and not gpe and input.UserInputType==Enum.UserInputType.Keyboard then
                    if input.KeyCode==key then pcall(callback,key) end
                end
            end)

            Library.Elements[text]={Set=function(self,k) key=k; KB.Text=k.Name end}
            table.insert(Library.SearchIndex,{Name=text,Tab=name,Instance=Fr})
        end

        return Tab
    end

    function Window:AddConfig()
        local CT=Window:Tab("Config"); CT:Label("Appearance")
        local names={}; for n in pairs(Library.Themes) do table.insert(names,n) end; table.sort(names)
        CT:Dropdown("Theme",names,function(sel) Library:SetTheme(sel) end)
        CT:Toggle("Glass Transparency",true,function(val) Library.Settings.Transparency=val; Library:RefreshTheme() end)
        CT:Label("Save / Load")
        CT:Button("Save Config",function() SaveConfig(); Library:Notification({Title="Config",Content="Configuration Saved.",Duration=3}) end)
        CT:Button("Load Config",function()
            if LoadConfig() then Library:RefreshTheme(); Library:Notification({Title="Config",Content="Configuration Loaded.",Duration=3})
            else Library:Notification({Title="Config",Content="No save file found.",Duration=3}) end
        end)
        CT:Button("Delete Config",function()
            pcall(function()
                if isfile and isfile(CONFIG_FILE) then delfile(CONFIG_FILE); Library:Notification({Title="Config",Content="Configuration Deleted.",Duration=3})
                else Library:Notification({Title="Config",Content="No file to delete.",Duration=3}) end
            end)
        end)
    end

    return Window
end

return Library
