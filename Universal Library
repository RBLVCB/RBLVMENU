                Tw(v, {TextColor3 = on and Library.CurrentTheme.Accent or Color3.fromRGB(130,145,165)}, 0.15)
                local bar=v:FindFirstChild("ActiveBar")
                if bar then Tw(bar, {BackgroundTransparency = on and 0 or 1}, 0.15) end
            end
