    -- ==================== REFRESH THEME ====================
    function Library:RefreshTheme()
        local T=Library.CurrentTheme; local tr=GT()
        Tw(MainFrame,{BackgroundColor3=T.Main,BackgroundTransparency=tr},0.25)
        Tw(TopBar,{BackgroundColor3=T.Top,BackgroundTransparency=tr},0.25)
        Tw(TBFix,{BackgroundColor3=T.Top,BackgroundTransparency=tr},0.25)
        Tw(SearchBox,{BackgroundColor3=T.Element,BackgroundTransparency=GT(0.1)},0.25)
        TitleDot.BackgroundColor3=T.Accent; TitleLbl.TextColor3=T.Text
        PillDot.BackgroundColor3=T.Accent
        if not _pillHidden then
            OpenBtn.BackgroundColor3=T.Top
            OBS.Color=T.Accent; OpenBtn.TextColor3=T.Accent
        end
        for _,obj in pairs(TabScroll:GetChildren()) do
            if obj:IsA("TextButton") then
                local bar=obj:FindFirstChild("ActiveBar")
                local on=(bar and bar.BackgroundTransparency<1)
                obj.TextColor3=on and T.Accent or Color3.fromRGB(130,142,160)
                if bar then bar.BackgroundColor3=T.Accent end
            end
        end
        for _,page in pairs(PagesFolder:GetChildren()) do
            if not page:IsA("ScrollingFrame") then continue end
            page.ScrollBarImageColor3=T.Accent
            for _,elem in pairs(page:GetChildren()) do
                if elem:IsA("TextLabel") and elem.Name=="SectionLbl" then
                    elem.TextColor3=T.Accent
                    local ln=elem:FindFirstChild("Line"); if ln then ln.BackgroundColor3=T.Accent end
                elseif elem:IsA("Frame") and elem.Name=="ElemFrame" then
                    Tw(elem,{BackgroundColor3=T.Element,BackgroundTransparency=tr},0.25)
                    local lbl=elem:FindFirstChild("ElemLbl"); if lbl then lbl.TextColor3=T.Text end
                    for _,c in pairs(elem:GetChildren()) do
                        if c:IsA("TextButton") then c.TextColor3=T.Text end
                        if c:IsA("TextLabel") and c.Name=="Arrow" then c.TextColor3=Color3.fromRGB(120,132,150) end
                    end
                    local tt=elem:FindFirstChild("ToggleTrack")
                    if tt then 
                        local kn=tt:FindFirstChild("ToggleKnob")
                        if kn then kn.BackgroundColor3=kn:GetAttribute("On") and T.Accent or Color3.fromRGB(120,132,150) end 
                    end
                    local st=elem:FindFirstChild("SliderTrack")
                    if st then local sf=st:FindFirstChild("SliderFill"); if sf then sf.BackgroundColor3=T.Accent end end
                    local sv=elem:FindFirstChild("SliderValue"); if sv then sv.TextColor3=T.Accent end
                    local lf=elem:FindFirstChildOfClass("ScrollingFrame")
                    if lf then lf.BackgroundColor3=T.Top; lf.BackgroundTransparency=tr; lf.ScrollBarImageColor3=T.Accent end
                    local tbx=elem:FindFirstChildOfClass("TextBox")
                    if tbx then local bs=tbx:FindFirstChildOfClass("UIStroke"); if bs then bs.Color=T.Accent end end
                    local kbtn=elem:FindFirstChild("KeyBtn")
                    if kbtn then local ks=kbtn:FindFirstChildOfClass("UIStroke"); if ks then ks.Color=T.Accent end end
                end
            end
        end
    end

    function Library:SetTheme(name)
        if Library.Themes[name] then
            Library.CurrentTheme=Library.Themes[name]; Library.Settings.Theme=name
            Library:RefreshTheme()
        end
    end

