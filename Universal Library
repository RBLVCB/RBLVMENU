                Toggled=val; Library.Flags[text]=Toggled; Knob:SetAttribute("On",Toggled)
                Tw(Track,{BackgroundTransparency=Toggled and 0.1 or 0.85},0.18)
                Tw(Knob,{Position=Toggled and UDim2.new(1,-21,0.5,0) or UDim2.new(0,3,0.5,0),
                    BackgroundColor3=Toggled and Library.CurrentTheme.Accent or Color3.fromRGB(120,135,155)},0.18,Enum.EasingStyle.Back)
