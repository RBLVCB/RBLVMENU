            Chev.Text="⌄"; Chev.TextColor3=Color3.fromRGB(120,135,155); Chev.Font=Enum.Font.GothamBold; Chev.TextSize=13; Chev.ZIndex=3
            
            local LF=Instance.new("ScrollingFrame",Fr); LF.BackgroundColor3=T.Top; LF.BackgroundTransparency=GT()
            LF.BorderSizePixel=0; LF.Position=UDim2.new(0,0,0,40); LF.Size=UDim2.new(1,0,0,LM)
            LF.CanvasSize=UDim2.new(0,0,0,0); LF.ScrollBarThickness=3
            LF.ScrollBarImageColor3=T.Accent; LF.Visible=false; LF.ZIndex=5
            Instance.new("UICorner",LF).CornerRadius=UDim.new(0,10)
            
            local il=Instance.new("UIListLayout",LF); il.SortOrder=Enum.SortOrder.LayoutOrder; il.Padding=UDim.new(0,1)
            local ip=Instance.new("UIPadding",LF); ip.PaddingTop=UDim.new(0,3); ip.PaddingLeft=UDim.new(0,3); ip.PaddingRight=UDim.new(0,3)
            
            local Hit=Instance.new("TextButton",Fr); Hit.BackgroundTransparency=1
            Hit.Size=UDim2.new(1,0,0,38); Hit.Text=""; Hit.ZIndex=4; Hit.AutoButtonColor=false
            
            local function Sel2(item)
                Sel.Text=text.."  ·  "..item; Library.Flags[text]=item
                dropped=false; LF.Visible=false; Fr.Size=UDim2.new(1,0,0,38); Chev.Rotation=0
                pcall(callback,item)
            end
            
            local function Build(items)
                for _,c in pairs(LF:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
                for i,item in ipairs(items) do
                    local ib=Instance.new("TextButton",LF)
                    ib.BackgroundColor3=Color3.fromRGB(255,255,255); ib.BackgroundTransparency=0.92
                    ib.Size=UDim2.new(1,0,0,IH-1); ib.Font=Enum.Font.Gotham; ib.Text=item
                    ib.TextColor3=Library.CurrentTheme.Text; ib.TextSize=11
                    ib.AutoButtonColor=false; ib.BorderSizePixel=0; ib.LayoutOrder=i; ib.ZIndex=6
                    Instance.new("UICorner",ib).CornerRadius=UDim.new(0,8)
                    ib.InputBegan:Connect(function(i) 
                        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                            Sel2(item) 
                        end
                    end)
                    ib.MouseEnter:Connect(function() ib.BackgroundColor3=Library.CurrentTheme.Accent; ib.BackgroundTransparency=0.45 end)
                    ib.MouseLeave:Connect(function() ib.BackgroundColor3=Color3.fromRGB(255,255,255); ib.BackgroundTransparency=0.92 end)
                end
                LF.CanvasSize=UDim2.new(0,0,0,#items*IH+8)
            end
            Build(list)
            
            local function CalcH() return math.min(#list*IH+8,LM) end
            Hit.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dropped=not dropped
                    if dropped then
                        local lh=CalcH(); LF.Size=UDim2.new(1,0,0,lh)
                        LF.Visible=true; LF.CanvasPosition=Vector2.new(0,0); Fr.Size=UDim2.new(1,0,0,40+lh)
                        Tw(Chev,{Rotation=180},0.18)
                    else
                        LF.Visible=false; Fr.Size=UDim2.new(1,0,0,38); Tw(Chev,{Rotation=0},0.18)
                    end
                    Page.CanvasSize=UDim2.new(0,0,0,PL.AbsoluteContentSize.Y+16)
                end
            end)
            Library.Elements[text]={
                Set=function(self,v) Sel2(v) end,
                Refresh=function(self,newList) list=newList; Build(newList)
                    if dropped then local lh=CalcH(); LF.Size=UDim2.new(1,0,0,lh); Fr.Size=UDim2.new(1,0,0,40+lh)
                        Page.CanvasSize=UDim2.new(0,0,0,PL.AbsoluteContentSize.Y+16) end
                end,
            }
            table.insert(Library.SearchIndex,{Name=text,Tab=name,Instance=Fr})
            return Sel
        end

        function Tab:Textbox(text, placeholder, callback)
            local T=Library.CurrentTheme
            local Fr=ElemBase(52)
            local Lbl=ElemLbl(Fr,text,6,11)
            Lbl.Size=UDim2.new(1,-24,0,16)
            
            local Box=Instance.new("TextBox",Fr)
            Box.BackgroundColor3=Color3.fromRGB(255,255,255); Box.BackgroundTransparency=0.9
            Box.BorderSizePixel=0
            Box.Position=UDim2.new(0,10,0,24); Box.Size=UDim2.new(1,-20,0,22)
            Box.Font=Enum.Font.Gotham; Box.PlaceholderText=placeholder or ""
            Box.PlaceholderColor3=Color3.fromRGB(130,145,165)
            Box.Text=""; Box.TextColor3=T.Text; Box.TextSize=11
            Box.ClearTextOnFocus=false; Box.ZIndex=4
            Instance.new("UICorner",Box).CornerRadius=UDim.new(1,0)
            
            local BS=Instance.new("UIStroke",Box)
            BS.Color=T.Accent; BS.Thickness=1; BS.Transparency=0.75
            Box.Focused:Connect(function()  Tw(BS,{Transparency=0.2},0.15) end)
            Box.FocusLost:Connect(function(enter)
                Tw(BS,{Transparency=0.75},0.15)
                if enter then pcall(callback,Box.Text) end
            end)
            Library.Elements[text]={Set=function(self,v) Box.Text=v end}
            table.insert(Library.SearchIndex,{Name=text,Tab=name,Instance=Fr})
        end

        function Tab:Keybind(text, default, callback)
            local T=Library.CurrentTheme; local key=default or Enum.KeyCode.Unknown; local binding=false
            Library.Flags[text]=key
            local Fr=ElemBase(38); ElemLbl(Fr,text)
            
            local KB=Instance.new("TextButton",Fr); KB.Name="KeyBtn"
            KB.BackgroundColor3=Color3.fromRGB(255,255,255); KB.BackgroundTransparency=0.9
            KB.AnchorPoint=Vector2.new(1,0.5); KB.Position=UDim2.new(1,-12,0.5,0); KB.Size=UDim2.new(0,72,0,24)
            KB.Font=Enum.Font.GothamMedium; KB.Text=key==Enum.KeyCode.Unknown and "None" or key.Name
            KB.TextColor3=Color3.fromRGB(190,205,220); KB.TextSize=10; KB.AutoButtonColor=false; KB.BorderSizePixel=0; KB.ZIndex=4
            Instance.new("UICorner",KB).CornerRadius=UDim.new(1,0)
            
            local kbs=Instance.new("UIStroke",KB); kbs.Color=T.Accent; kbs.Thickness=1; kbs.Transparency=0.75
            KB.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                    binding=true; KB.Text="..."; KB.TextColor3=T.Accent; Tw(kbs,{Transparency=0.25},0.12)
                end
            end)
            UserInputService.InputBegan:Connect(function(input,gpe)
                if binding and not gpe and input.UserInputType==Enum.UserInputType.Keyboard then
                    key=input.KeyCode; binding=false; KB.Text=key.Name
                    KB.TextColor3=Color3.fromRGB(190,205,220); Tw(kbs,{Transparency=0.75},0.12)
                    Library.Flags[text]=key
                elseif not binding and not gpe and input.UserInputType==Enum.UserInputType.Keyboard then
                    if input.KeyCode==key then pcall(callback,key) end
                end
            end)
            Library.Elements[text]={Set=function(self,k) key=k; KB.Text=k.Name end}
            table.insert(Library.SearchIndex,{Name=text,Tab=name,Instance=Fr})
        end

        return Tab
    end

    function Window:AddConfig()
        local CT=Window:Tab("Config"); CT:Label("Appearance")
        local names={}; for n in pairs(Library.Themes) do table.insert(names,n) end; table.sort(names)
        CT:Dropdown("Theme",names,function(sel) Library:SetTheme(sel) end)
        CT:Toggle("Glass Transparency",true,function(val) Library.Settings.Transparency=val; Library:RefreshTheme() end)
        CT:Label("Save / Load")
        CT:Button("Save Config",function() SaveConfig(); Library:Notification({Title="Config",Content="Config saved.",Duration=3}) end)
        CT:Button("Load Config",function()
            if LoadConfig() then Library:RefreshTheme(); Library:Notification({Title="Config",Content="Config loaded.",Duration=3})
            else Library:Notification({Title="Config",Content="No save file found.",Duration=3}) end
        end)
        CT:Button("Delete Config",function()
            pcall(function()
                if isfile and isfile(CONFIG_FILE) then delfile(CONFIG_FILE); Library:Notification({Title="Config",Content="Config deleted.",Duration=3})
                else Library:Notification({Title="Config",Content="No file to delete.",Duration=3}) end
            end)
        end)
    end

    return Window
end

return Library
