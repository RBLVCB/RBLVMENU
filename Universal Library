    ApplyTabLayout()

    -- Search logic
    local function SwitchToTab(name)
        for _,v in pairs(TabScroll:GetChildren()) do
            if v:IsA("TextButton") then
                local on=(v.Name==name)
                v.TextColor3= on and Library.CurrentTheme.Accent or Color3.fromRGB(130,140,155)
                local bar=v:FindFirstChild("ActiveBar")
                local pill=v:FindFirstChild("ActivePill")
                if bar  then bar.BackgroundTransparency  = on and 0 or 1 end
                if pill then pill.BackgroundTransparency = on and 0.78 or 1 end
            end
        end
        for _,v in pairs(PagesFolder:GetChildren()) do
            if v:IsA("ScrollingFrame") then v.Visible=(v.Name==name) end
        end
    end

    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local txt=SearchBox.Text:lower(); if txt=="" then return end
        for _,item in pairs(Library.SearchIndex) do
            if string.find(item.Name:lower(),txt) then
                SwitchToTab(item.Tab)
                local pg=PagesFolder:FindFirstChild(item.Tab)
                if pg and item.Instance then
                    Tw(pg,{CanvasPosition=Vector2.new(0,item.Instance.AbsolutePosition.Y-pg.AbsolutePosition.Y+pg.CanvasPosition.Y)},0.3)
                end
                break
            end
        end
    end)

