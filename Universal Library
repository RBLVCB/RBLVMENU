    TBSep.BorderSizePixel=0; TBSep.Position=UDim2.new(0,0,0,38); TBSep.Size=UDim2.new(1,0,0,1)

    -- ── Row 2: tab scroll (horizontal mode) ──
    local TabRow=Instance.new("Frame",TopBar)
    TabRow.Name="TabRow"; TabRow.BackgroundTransparency=1
    TabRow.Size=UDim2.new(1,0,0,38); TabRow.Position=UDim2.new(0,0,0,38)

    -- TabScroll lives in TabRow (horizontal) or in a sidebar (vertical)
    -- We manage these via the layout state below.

    -- Toggle/close
    Library.IsOpen=true
    function Library:Toggle()
        Library.IsOpen=not Library.IsOpen
        if Library.IsOpen then
            OpenBtn.Visible=false; MainFrame.Visible=true
            Tw(MainFrame,{Size=UDim2.new(0,W,0,H)},0.3)
        else
            TweenService:Create(MainFrame,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(0,W,0,0)}):Play()
            task.delay(0.31, function()
                if not Library.IsOpen then MainFrame.Visible=false; OpenBtn.Visible=true end
            end)
        end
    end
    CloseBtn.MouseButton1Click:Connect(function() Library:Toggle() end)
    OpenBtn.MouseButton1Click:Connect(function() Library:Toggle() end)
    MakeDraggable(TitleRow, MainFrame)

    -- ── Layout state ──
    local tabDirection="h"
    local TabScroll, TabLayout
    local Sidebar           -- Frame, exists only in vertical mode
    local PageContainer, PagesFolder

    local function DestroyLayoutFrames()
        if PageContainer then
            for _,c in pairs(PagesFolder:GetChildren()) do
                if c:IsA("ScrollingFrame") then c.Parent=MainFrame end
            end
            PageContainer:Destroy(); PageContainer=nil; PagesFolder=nil
        end
        if TabScroll then TabScroll:Destroy(); TabScroll=nil end
        if Sidebar   then Sidebar:Destroy();   Sidebar=nil   end
    end

    local function ApplyTabLayout()
        DestroyLayoutFrames()
        local T=Library.CurrentTheme

        if tabDirection=="h" then
            -- TabScroll inside TabRow
            TabScroll=Instance.new("ScrollingFrame",TabRow)
            TabScroll.BackgroundTransparency=1; TabScroll.Size=UDim2.new(1,0,1,0)
            TabScroll.ScrollBarThickness=0; TabScroll.BorderSizePixel=0
            TabScroll.CanvasSize=UDim2.new(0,0,0,0); TabScroll.ScrollingDirection=Enum.ScrollingDirection.X
            TabLayout=Instance.new("UIListLayout",TabScroll)
            TabLayout.FillDirection=Enum.FillDirection.Horizontal
            TabLayout.SortOrder=Enum.SortOrder.LayoutOrder; TabLayout.Padding=UDim.new(0,0)
            local p=Instance.new("UIPadding",TabScroll); p.PaddingLeft=UDim.new(0,8)
            TabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                TabScroll.CanvasSize=UDim2.new(0,TabLayout.AbsoluteContentSize.X+16,0,0)
            end)
            TabRow.Visible=true

            -- Content below entire TopBar
            PageContainer=Instance.new("Frame",MainFrame)
            PageContainer.BackgroundTransparency=1
            PageContainer.Position=UDim2.new(0,0,0,TOPBAR_H)
            PageContainer.Size=UDim2.new(1,0,1,-TOPBAR_H-4)
            PageContainer.ClipsDescendants=true
        else
            -- Sidebar to the left, starts below TopBar
            -- Hide tab row (tabs go into sidebar instead)
            TabRow.Visible=false

            Sidebar=Instance.new("Frame",MainFrame)
            Sidebar.Name="Sidebar"; Sidebar.BackgroundColor3=T.Top
            Sidebar.BackgroundTransparency=GT(); Sidebar.BorderSizePixel=0
            Sidebar.Position=UDim2.new(0,0,0,TOPBAR_H)
            Sidebar.Size=UDim2.new(0,SIDEBAR_W,1,-TOPBAR_H)
            -- right divider
            local sdiv=Instance.new("Frame",Sidebar)
            sdiv.BackgroundColor3=Color3.fromRGB(255,255,255); sdiv.BackgroundTransparency=0.90
            sdiv.BorderSizePixel=0; sdiv.Position=UDim2.new(1,-1,0,0); sdiv.Size=UDim2.new(0,1,1,0)

            TabScroll=Instance.new("ScrollingFrame",Sidebar)
            TabScroll.BackgroundTransparency=1; TabScroll.Size=UDim2.new(1,-1,1,0)
            TabScroll.ScrollBarThickness=2; TabScroll.BorderSizePixel=0
            TabScroll.CanvasSize=UDim2.new(0,0,0,0); TabScroll.ScrollingDirection=Enum.ScrollingDirection.Y
            TabLayout=Instance.new("UIListLayout",TabScroll)
            TabLayout.FillDirection=Enum.FillDirection.Vertical
            TabLayout.SortOrder=Enum.SortOrder.LayoutOrder; TabLayout.Padding=UDim.new(0,3)
            local p=Instance.new("UIPadding",TabScroll)
