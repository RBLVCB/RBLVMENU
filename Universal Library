            local Hit=Instance.new("TextButton",Fr); Hit.BackgroundTransparency=1
            Hit.Size=UDim2.new(1,0,1,0); Hit.Text=""; Hit.AutoButtonColor=false
            local function Update(val)
                Toggled=val; Library.Flags[text]=Toggled; Knob:SetAttribute("On",Toggled)
                Tw(Track,{BackgroundTransparency=Toggled and 0.0 or 0.82},0.15)
