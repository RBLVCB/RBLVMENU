-- ==================== UTILITY & ANIMATION ====================
local function Tw(obj, props, t, style, dir)
    TweenService:Create(obj, TweenInfo.new(t or 0.22, style or Enum.EasingStyle.OutQuint, dir or Enum.EasingDirection.Out), props):Play()
end

local function MakeDraggable(handle, frame)
    local drag, sp, sf = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag=true; sp=i.Position; sf=frame.Position
            i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then drag=false end end)
        end
    end)
    handle.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local d=i.Position-sp
            frame.Position=UDim2.new(sf.X.Scale,sf.X.Offset+d.X,sf.Y.Scale,sf.Y.Offset+d.Y)
        end
    end)
end

local function GT(extra)
    local t = Library.Settings.Transparency and (Library.CurrentTheme.Trans or 0.25) or 0
    return math.clamp(t+(extra or 0), 0, 0.95)
end

-- Refined Glass Specular Shine Overlay Helper
local function AddGlassShine(parent, cornerRadius)
    local shine = Instance.new("Frame", parent)
    shine.Name = "GlassShine"
    shine.Size = UDim2.new(1, 0, 0.45, 0)
    shine.Position = UDim2.new(0, 0, 0, 0)
    shine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shine.BackgroundTransparency = 0.94
    shine.BorderSizePixel = 0
    shine.ZIndex = parent.ZIndex + 1
    Instance.new("UICorner", shine).CornerRadius = cornerRadius or UDim.new(0, 12)
    
    local grad = Instance.new("UIGradient", shine)
    grad.Rotation = 90
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(0.5, 0.7),
        NumberSequenceKeypoint.new(1, 1)
    })
    return shine
end

-- Dynamic Glass Border Gradient Helper
local function ApplyGlassStroke(stroke)
    local grad = Instance.new("UIGradient", stroke)
    grad.Rotation = 45
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 180, 210)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    })
    return grad
end

-- ==================== FILE SYSTEM ====================
local FOLDER_NAME = "UniversalMenu"
local CONFIG_FILE = FOLDER_NAME.."/config.json"

function Library:SetProjectConfig(folder, configFile)
    FOLDER_NAME = folder or FOLDER_NAME
    CONFIG_FILE = (folder or FOLDER_NAME).."/".. (configFile or "config.json")
end
pcall(function()
    if makefolder and not (isfolder and isfolder(FOLDER_NAME)) then makefolder(FOLDER_NAME) end
end)
Library._GetFloatData = nil
Library._SetFloatData = nil

local function SaveConfig()
    pcall(function()
        if not writefile then return end
        if makefolder and not (isfolder and isfolder(FOLDER_NAME)) then makefolder(FOLDER_NAME) end
        local data = {}
        for k,v in pairs(Library.Flags) do data[k]=(typeof(v)=="EnumItem") and tostring(v) or v end
        data["__theme"]=Library.Settings.Theme; data["__transparency"]=Library.Settings.Transparency
        if Library._GetFloatData then data["__floats"]=Library._GetFloatData() end
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

local function LoadConfig()
    local found=false
    pcall(function()
        if not (isfile and isfile(CONFIG_FILE)) then return end
        found=true
        local data=HttpService:JSONDecode(readfile(CONFIG_FILE))
        if data["__theme"] and Library.Themes[data["__theme"]] then
            Library.CurrentTheme=Library.Themes[data["__theme"]]; Library.Settings.Theme=data["__theme"]
        end
        if data["__transparency"]~=nil then Library.Settings.Transparency=data["__transparency"] end
        if data["__floats"] and Library._SetFloatData then Library._SetFloatData(data["__floats"]) end
        for k,v in pairs(data) do
            if k=="__theme" or k=="__floats" or k=="__transparency" then continue end
            if Library.Elements[k] then
                pcall(function()
                    if type(v)=="string" and v:sub(1,13)=="Enum.KeyCode." then
                        local kc=Enum.KeyCode[v:sub(14)]; if kc then Library.Elements[k]:Set(kc) end
                    else Library.Elements[k]:Set(v) end
                end)
            end
        end
    end)
    return found
end
Library.SaveConfig=SaveConfig; Library.LoadConfig=LoadConfig

