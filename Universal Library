        -- SLIDER
        function Tab:Slider(text, min, max, default, callback)
            local T=Library.CurrentTheme; local val=default or min; local sliding=false
            Library.Flags[text]=val
            -- Frame 44px:
            -- Row (y=0, h=36):  [Name — left]  [Value — right]  on ONE line
            -- Track (y=38, h=4): full width bar
            local Fr=ElemBase(44)

            -- Name: anchored left, fills left 70% of row height
            local SLbl=Instance.new("TextLabel",Fr); SLbl.Name="ElemLbl"
            SLbl.BackgroundTransparency=1
            SLbl.Position=UDim2.new(0,12,0,0)
            SLbl.Size=UDim2.new(0.7,-8,0,36)
            SLbl.Font=Enum.Font.Gotham; SLbl.Text=text
            SLbl.TextColor3=T.Text; SLbl.TextSize=12
            SLbl.TextXAlignment=Enum.TextXAlignment.Left
            SLbl.TextYAlignment=Enum.TextYAlignment.Center

            -- Value: anchored to right edge of frame, same row height
            local ValLbl=Instance.new("TextLabel",Fr); ValLbl.Name="SliderValue"
            ValLbl.BackgroundTransparency=1
            ValLbl.AnchorPoint=Vector2.new(1,0)  -- anchor TOP-RIGHT corner
            ValLbl.Position=UDim2.new(1,-10,0,0)  -- 10px from right edge
            ValLbl.Size=UDim2.new(0.28,-4,0,36)   -- 28% width, same height as name
            ValLbl.Font=Enum.Font.GothamMedium; ValLbl.Text=tostring(val)
            ValLbl.TextColor3=T.Accent; ValLbl.TextSize=12
            ValLbl.TextXAlignment=Enum.TextXAlignment.Right
            ValLbl.TextYAlignment=Enum.TextYAlignment.Center

            -- Track bar: below the text row
            local Track=Instance.new("Frame",Fr); Track.Name="SliderTrack"
            Track.BackgroundColor3=Color3.fromRGB(255,255,255); Track.BackgroundTransparency=0.78
            Track.BorderSizePixel=0; Track.Position=UDim2.new(0,12,0,38); Track.Size=UDim2.new(1,-24,0,4)
            Instance.new("UICorner",Track).CornerRadius=UDim.new(1,0)
            local Fill=Instance.new("Frame",Track); Fill.Name="SliderFill"
            Fill.BackgroundColor3=T.Accent; Fill.BackgroundTransparency=0.1; Fill.BorderSizePixel=0
            Fill.Size=UDim2.new((val-min)/(max-min),0,1,0)
            Instance.new("UICorner",Fill).CornerRadius=UDim.new(1,0)
            local SKnob=Instance.new("Frame",Track); SKnob.Name="SliderKnob"
            SKnob.BackgroundColor3=Color3.fromRGB(255,255,255); SKnob.BorderSizePixel=0
            SKnob.AnchorPoint=Vector2.new(0.5,0.5)
            SKnob.Position=UDim2.new((val-min)/(max-min),0,0.5,0); SKnob.Size=UDim2.new(0,10,0,10)
            Instance.new("UICorner",SKnob).CornerRadius=UDim.new(1,0)
            local Hit=Instance.new("TextButton",Fr); Hit.BackgroundTransparency=1
            Hit.Size=UDim2.new(1,0,1,0); Hit.Text=""; Hit.AutoButtonColor=false; Hit.ZIndex=4
            local function SetVal(v)
                val=math.clamp(v,min,max); Library.Flags[text]=val; ValLbl.Text=tostring(val)
                local pct=(val-min)/(max-min)
                Tw(Fill,{Size=UDim2.new(pct,0,1,0)},0.06); Tw(SKnob,{Position=UDim2.new(pct,0,0.5,0)},0.06)
                pcall(callback,val)
            end
            local function FI(i) SetVal(math.floor(min+(max-min)*math.clamp((i.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1))) end
            Hit.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then sliding=true; FI(i) end end)
            Hit.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then sliding=false end end)
            UserInputService.InputChanged:Connect(function(i) if sliding and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then FI(i) end end)
            Library.Elements[text]={Set=function(self,v) SetVal(v) end}
            table.insert(Library.SearchIndex,{Name=text,Tab=name,Instance=Fr})
        end

        -- DROPDOWN
